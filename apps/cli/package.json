{
  "name": "@codefossil/cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "codefossil": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@codefossil/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codefossil/ai": "workspace:*",
    "@codefossil/analyzers": "workspace:*",
    "@codefossil/api": "workspace:*",
    "@codefossil/core": "workspace:*",
    "@codefossil/db": "workspace:*",
    "@codefossil/git": "workspace:*",
    "@codefossil/parser": "workspace:*",
    "@codefossil/providers": "workspace:*",
    "@codefossil/query": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
